# Copy this file to .env.local and fill in your key. .env.local is gitignored.
# The CURATED guide library works with NO key. A key is only needed for the
# live "Generate a guide for any app" agent.

# Your Anthropic API key (https://console.anthropic.com/). Required for live generation.
ANTHROPIC_API_KEY=

# Optional overrides for the live-generation agent:
# LAUNCHPAD_MODEL=claude-opus-5     # the model the agent uses
# LAUNCHPAD_EFFORT=medium           # low | medium | high | xhigh | max (latency vs depth)
